    "test:isolation:sync-deferred": "node --test scripts/__tests__/sync-deferred-boundary-receipt.test.mjs && vitest run src/services/__tests__/crossDeviceSyncService.deferred.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "preview": "vite preview",
    "test:a11y": "playwright test tests/a11y/",
    "test:a11y:ci": "playwright test tests/a11y/ci-release.spec.ts tests/a11y/target-size.spec.ts tests/a11y/keyboard-access.spec.ts tests/a11y/reduced-motion.spec.ts --project=chromium-a11y",
    "test:e2e:ci": "playwright test tests/e2e/current-ui-smoke.spec.ts --project=chromium-e2e",
    "test:e2e:legacy": "playwright test --project=chromium-e2e-legacy"
  },
